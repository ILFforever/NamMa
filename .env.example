# Copy to .env and fill in. Never commit .env.

# Database (local docker-compose default; swap for the RDS URL later)
DATABASE_URL=postgresql://namma:namma@localhost:5432/namma

# Huawei Cloud: the app calls no Huawei API with account keys (setup is done in the console), so no AK/SK here.
# Region ID for reference (AP-Bangkok; confirm in the console).
HW_REGION=

# MaaS (LLM)
MAAS_BASE_URL=
MAAS_API_KEY=
MAAS_MODEL=

# OBS (raw JSON archive; leave empty to keep raw files under ./var/raw)
OBS_BUCKET=
OBS_ENDPOINT=

# GISTDA
GISTDA_API_KEY=

# LINE Messaging API + LINE Login
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# App (api.main)
# DEMO_MODE=1 enables demo login (id_token "demo:responder" / "demo:user") and POST /api/demo/simulate. 0 in production.
DEMO_MODE=1
# LINE userIds (comma-separated) who get the responder role on LINE login: the rescue dashboard, /api/tickets,
# /api/demo/*. Without DEMO_MODE this is the only way to become a responder.
RESPONDER_LINE_IDS=
# SCHEDULER=1 runs ingest → risk → alerts inside the API every SCHEDULER_EVERY seconds (ECS setup).
SCHEDULER=0
SCHEDULER_EVERY=600
RAW_KEEP_DAYS=7
