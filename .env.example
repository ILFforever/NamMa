# Copy to .env and fill in. Never commit .env.

# Database (local docker-compose default; swap for the RDS URL later)
DATABASE_URL=postgresql://namma:namma@localhost:5432/namma

# Huawei Cloud: the app calls no Huawei API with account keys (setup is done in the console), so no AK/SK here.
# Region ID for reference (AP-Bangkok; confirm in the console).
HW_REGION=

# LLM: any OpenAI-compatible server (names are from the Huawei MaaS plan). Optional; rules run without it.
# Chula: MAAS_BASE_URL=https://llm.nattee.net/v1, MAAS_MODEL=qwen3.5, LLM_NO_THINKING=1.
# The Chula key has a daily quota and expires after 2 weeks; when it fails the chat falls back to rules.
MAAS_BASE_URL=
MAAS_API_KEY=
MAAS_MODEL=
LLM_NO_THINKING=

# OBS (raw JSON archive; leave empty to keep raw files under ./var/raw). On the VM: OBS_BUCKET=namma.
# Credentials come from the VM's IAM agency, never an AK/SK here. Endpoint defaults to AP-Bangkok's.
OBS_BUCKET=
OBS_ENDPOINT=

# GISTDA (sent in the API-Key header). With SCHEDULER=1 the 3-day and 7-day flood layers are fetched every
# GISTDA_EVERY seconds; an unchanged layer costs one page.
GISTDA_API_KEY=
GISTDA_EVERY=10800

# LINE Messaging API + LINE Login
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# App (api.main)
# DEMO_MODE=1 enables demo login (id_token "demo:user", "demo:user:<name>" = one account per name,
# "demo:google:<name>") and POST /api/demo/simulate + /api/demo/refresh for any signed-in session. 0 in production.
DEMO_MODE=1
# SCHEDULER=1 runs ingest → risk → alerts inside the API every SCHEDULER_EVERY seconds (ECS setup).
SCHEDULER=0
SCHEDULER_EVERY=600
RAW_KEEP_DAYS=7

# Google Sign-In for the web app (an OAuth client of type "Web application" in Google Cloud Console). Public value.
# Unset: POST /api/auth/google answers 503. DEMO_MODE also accepts id_token "demo:google:<name>".
GOOGLE_CLIENT_ID=
