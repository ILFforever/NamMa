# Copy to .env and fill in. Never commit .env.

# Database (local docker-compose default; swap for the RDS URL later)
DATABASE_URL=postgresql://namma:namma@localhost:5432/namma

# Huawei Cloud (IAM sub-user)
HW_REGION=
HW_ACCESS_KEY=
HW_SECRET_KEY=
HW_PROJECT_ID=

# MaaS (LLM)
MAAS_BASE_URL=
MAAS_API_KEY=
MAAS_MODEL=

# OBS (raw JSON archive; leave empty to keep raw files under ./var/raw)
OBS_BUCKET=
OBS_ENDPOINT=

# GISTDA
GISTDA_API_KEY=

# LINE Messaging API + LINE Login
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# App (api.main)
# DEMO_MODE=1 enables POST /api/demo/simulate and, without RESPONDER_TOKEN, an open dashboard. 0 in production.
DEMO_MODE=1
# Bearer token for the responder dashboard and /api/tickets. Open dashboard.html?token=<this> once.
RESPONDER_TOKEN=
# SCHEDULER=1 runs ingest → risk → alerts inside the API every SCHEDULER_EVERY seconds (ECS setup).
SCHEDULER=0
SCHEDULER_EVERY=600
RAW_KEEP_DAYS=7
